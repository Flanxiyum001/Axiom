# Public frontend build settings; only the relative same-origin API path is browser-visible.
NEXT_PUBLIC_AXIOM_DEMO_MODE=1
NEXT_PUBLIC_AXIOM_API_URL=/api

# Private server-side destination. Set as a Railway service variable, never NEXT_PUBLIC_*.
# This is the internal hostname of the private backend service in the same Railway environment.
AXIOM_BACKEND_INTERNAL_URL=http://axiom-backend.railway.internal:8000
