# Backend process only. Copy values into the host's environment, not a public bundle.
# Start with PYTHON_DOTENV_DISABLED=1 in the process environment so a local .env is ignored.
AXIOM_DEMO_MODE=1
AXIOM_REASONING_PROVIDER=echo
AXIOM_EXECUTOR_BACKEND=local
AXIOM_DB_PATH=:memory:
AXIOM_MAX_ITERATIONS=1
AXIOM_RUN_TIMEOUT_SECONDS=10
# Set to the exact HTTPS origin of the judge-facing frontend before deployment.
# AXIOM_CORS_ORIGINS=
# No NEBIUS_* credentials or GPU settings belong in this demo process.
