# Environment variables for AXIOM
# Copy this file to .env and fill in the values when ready.

# LLM Provider Selection
# Default: mock (deterministic, no API key needed, perfect for testing)
# Options: mock, nebius
AXIOM_LLM_PROVIDER=mock

# Nebius Token Factory Configuration
# Required when AXIOM_LLM_PROVIDER=nebius
# NEBIUS_API_KEY=YOUR_NE... (do not commit any real key)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_REQUEST_TIMEOUT=60
NEBIUS_MAX_RETRIES=3

# Mock Provider Settings
MOCK_SEED=42

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
