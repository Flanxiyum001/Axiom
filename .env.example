# Environment variables for AXIOM
# Copy this file to .env and fill in the values when ready.

# Provider selection for both application stacks.
# Options: mock (deterministic) or nebius (real Token Factory inference).
# The canonical API also accepts AXIOM_REASONING_PROVIDER; if both variables
# are set, AXIOM_REASONING_PROVIDER takes precedence there.
# In canonical Settings, the legacy value 'mock' maps to the deterministic 'echo' provider.
AXIOM_LLM_PROVIDER=mock
AXIOM_REASONING_PROVIDER=echo
AXIOM_EXECUTOR_BACKEND=local

# Nebius Token Factory Configuration
# Required when the selected provider is nebius. Never commit a real key.
# NEBIUS_API_KEY=replace-with-your-token-factory-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_REQUEST_TIMEOUT=60
NEBIUS_MAX_RETRIES=3

# Mock Provider Settings
MOCK_SEED=42

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
